# Discord Bot Configuration

# Discord bot token from Discord Developer Portal
DISCORD_TOKEN=

# Discord guild (server) ID for faster command sync (optional)
DISCORD_GUILD_ID=

# AI server URL for summarization and processing
AI_SERVER_URL=

# Timeout for AI server requests in seconds
AI_TIMEOUT_SECONDS=60

# Maximum number of messages to fetch for context
MESSAGE_LIMIT=500

# Comma-separated list of role IDs allowed to use bot commands (empty = all users)
ALLOWED_ROLE_IDS=

# Web search API key (Brave Search API or similar)
WEB_SEARCH_API_KEY=

# Web search API type (brave, google, etc.)
WEB_SEARCH_API_TYPE=brave
